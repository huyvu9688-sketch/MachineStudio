# PostgreSQL (matches docker-compose.yml defaults for local development)
DATABASE_URL="postgresql://machinestudio:machinestudio@localhost:5432/machinestudio?schema=public"

# Clerk authentication — get real keys from https://dashboard.clerk.com
# (Development instance keys, not Production). Optional: the app falls
# back to Clerk's keyless dev mode under `next dev` when unset.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Dedicated E2E test user (password auth, created on the Development
# instance above) for e2e/authenticated.spec.ts. Optional: that test
# self-skips when these, or the Clerk keys above, are unset.
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=

# TLS-intercepting corporate network only: Node must trust the proxy's root
# CA or every server-side HTTPS/WSS call (Neon, Clerk) fails and the
# workspace renders blank. Do NOT set NODE_EXTRA_CA_CERTS here — Node reads
# it at process startup, before this file is loaded, so a value in .env is
# silently ignored. Set it in the shell/OS environment before `npm run dev`:
#   PowerShell (persistent):
#     [Environment]::SetEnvironmentVariable(
#       "NODE_EXTRA_CA_CERTS", "C:\path\to\corporate-ca.pem", "User")
#   bash: export NODE_EXTRA_CA_CERTS=/path/to/corporate-ca.pem

// Schema v1 (project hierarchy, graph, runs, catalog, baselines) is a
// later work unit. This file only establishes the datasource and
// generator so Prisma is configured for local PostgreSQL development.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client"
  output   = "../lib/db/generated/prisma"
}

// Prisma 7 removed the `url` property from the datasource block (error
// P1012). The connection URL now lives in `prisma.config.ts` for the CLI
// (Migrate/introspection), and the runtime connection is supplied to the
// PrismaClient constructor through a driver adapter — see lib/db/client.ts.
//
// Storage-model rules (context/architecture.md "Storage Model",
// context/code-standards.md "Database and Migrations"):
//   - Identity, ownership, revision, lifecycle, and frequently filtered
//     fields are relational (this file). Module-specific value payloads use
//     versioned JSONB validated on both write and read (Unit 2.2:
//     `ParameterValue.value` holds an `EngineeringValue`; runs in 2.3).
//   - Timestamps are stored in UTC (`@db.Timestamptz`).
//   - Adding a conforming module must never require a schema change, so
//     nothing here is module-specific. The graph tables key values and links
//     by canonical `parameterId` strings, not per-module columns.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../lib/db/generated/prisma"
}

/// A platform user. Identity is owned by Clerk; this table is a local
/// ownership reference keyed by the Clerk user ID (`id`), not a profile
/// store (context/architecture.md "Auth and Access": every project has
/// exactly one owner, enforced on every project-related query/mutation).
model User {
  /// Clerk user ID (the external identity), used directly as the primary key.
  id        String   @id
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  projects MachineProject[]

  @@map("users")
}

/// A machine engineering project. Owned by exactly one `User`; deleting the
/// owner cascades to their projects and the whole subtree below.
model MachineProject {
  id               String   @id @default(cuid())
  ownerId          String
  name             String
  /// Primary market profile selected at creation, as a `marketProfileKey`
  /// (e.g. "US-General-Industrial-Machinery@1"). Validated against the
  /// standards registry at the application-service boundary (Unit 2.4).
  marketProfileKey String
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  owner          User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  configurations MachineConfiguration[]
  auditEvents    AuditEvent[]

  @@index([ownerId])
  @@map("machine_projects")
}

/// A design configuration (variant) of a project. Draft configurations
/// become immutable baselines in a later unit (Milestone 2, lib/configuration).
model MachineConfiguration {
  id        String   @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  project              MachineProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assemblies           Assembly[]
  workflowInstances    WorkflowInstance[]
  requirements         Requirement[]
  designAssumptions    DesignAssumption[]
  loadCases            LoadCase[]
  parameterValues      ParameterValue[]
  parameterLinks       ParameterLink[]
  componentAssignments ComponentAssignment[]
  baselines            MachineBaseline[]

  @@index([projectId])
  @@map("machine_configurations")
}

/// A node in a configuration's assembly hierarchy. `parentId` is null for a
/// root assembly; deleting an assembly cascades to its descendants. An
/// assembly is the scope for the parameter graph (context/architecture.md
/// "Parameter Graph").
model Assembly {
  id              String   @id @default(cuid())
  configurationId String
  parentId        String?
  name            String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  configuration        MachineConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  parent               Assembly?            @relation("AssemblyHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children             Assembly[]           @relation("AssemblyHierarchy")
  moduleInstances      ModuleInstance[]
  requirements         Requirement[]
  designAssumptions    DesignAssumption[]
  parameterValues      ParameterValue[]
  sourceOfLinks        ParameterLink[]
  componentAssignments ComponentAssignment[]

  @@index([configurationId])
  @@index([parentId])
  @@map("assemblies")
}

/// An instance of a guided workflow (e.g. `linear-axis@1`) coordinating a
/// set of module instances within a configuration, without combining their
/// compute logic (context/architecture.md "lib/workflows/").
model WorkflowInstance {
  id              String                 @id @default(cuid())
  configurationId String
  /// Stable workflow ID, e.g. "linear-axis".
  workflowId      String
  /// Semantic version of the workflow definition, e.g. "1.0.0".
  workflowVersion String
  status          WorkflowInstanceStatus @default(draft)
  createdAt       DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(6)

  configuration   MachineConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  moduleInstances ModuleInstance[]

  @@index([configurationId])
  @@map("workflow_instances")
}

/// A placed instance of a versioned calculation module within an assembly.
/// The exact released package is pinned by (`modulePackageId`,
/// `moduleVersion`) so a configuration records which module version it was
/// built with (context/architecture.md "Module Package Contract"). Detaching
/// a workflow does not delete its modules (`onDelete: SetNull`).
model ModuleInstance {
  id                 String   @id @default(cuid())
  assemblyId         String
  workflowInstanceId String?
  /// Stable module ID from the module manifest, e.g. "example-linear-thrust".
  modulePackageId    String
  /// Semantic version of the released module package, e.g. "0.1.0".
  moduleVersion      String
  label              String
  /// Normalized summary of the latest calculation run, set atomically with
  /// run persistence (Unit 2.4's `executeModuleInstance`) — the same
  /// "search-critical summary normalized into a column" pattern
  /// `CalculationRun.status` uses, one level up, so the module tree can
  /// render a status badge without joining every run. A plain scalar (not a
  /// Prisma relation) since `CalculationRun.moduleInstanceId` already owns
  /// the relation in the other direction. Null before any run exists (module
  /// status "not configured"/"ready", computed elsewhere from input
  /// completeness — context/ui-context.md "Status Model").
  lastCalculationRunId String?
  lastRunStatus        CheckStatus?
  createdAt            DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(6)

  assembly             Assembly          @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  workflowInstance     WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  parameterValues      ParameterValue[]
  targetOfLinks        ParameterLink[]   @relation("ParameterLinkTarget")
  sourceOfLinks        ParameterLink[]   @relation("ParameterLinkSource")
  calculationRuns      CalculationRun[]
  componentAssignments ComponentAssignment[]

  @@index([assemblyId])
  @@index([workflowInstanceId])
  @@index([lastRunStatus])
  @@map("module_instances")
}

/// Lifecycle of a `WorkflowInstance`. A full multi-user review workflow is
/// deferred (context/roadmap.md "Explicitly Deferred").
enum WorkflowInstanceStatus {
  draft
  active
  completed
  abandoned
}

// --- Unit 2.2: requirements and parameter graph --------------------------

/// Load-case category. Mirrors `LoadCaseCategory` in
/// lib/engine/parameters (Unit 1.3); kept in lockstep so persisted load
/// cases and graph nodes speak the same categories the engine validates.
enum LoadCaseCategory {
  normal
  peak
  holding
  emergency_stop
}

/// The role a value node plays in the parameter graph. Mirrors
/// `GraphNodeKind` in lib/engine/graph (Unit 1.8): every kind provides a
/// value (a source) except `module_input`, which consumes one (a sink).
enum ParameterNodeKind {
  machine_requirement
  assembly_parameter
  workflow_parameter
  module_input
  module_output
}

/// How an authored `ParameterValue` was supplied. `default` (the parameter
/// registry's constant) and `linked` (a `ParameterLink`) are resolution
/// outcomes, not stored rows, so only the authored sources appear here
/// (context/architecture.md: "Every input source is manual, linked, default,
/// or workflow-provided").
enum ParameterValueSource {
  manual
  workflow
}

/// A machine or assembly requirement (design intent). Machine-level when
/// `assemblyId` is null; otherwise scoped to an assembly. Verification links
/// to calculation runs are added with the run schema (Unit 2.3+).
model Requirement {
  id              String   @id @default(cuid())
  configurationId String
  /// Null for a machine-level requirement; set for an assembly-scoped one.
  assemblyId      String?
  /// Short human code, e.g. "REQ-01".
  code            String
  statement       String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  configuration      MachineConfiguration  @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  assembly           Assembly?             @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  acceptanceCriteria AcceptanceCriterion[]

  @@index([configurationId])
  @@index([assemblyId])
  @@map("requirements")
}

/// A testable acceptance criterion belonging to a requirement.
model AcceptanceCriterion {
  id            String   @id @default(cuid())
  requirementId String
  statement     String
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@map("acceptance_criteria")
}

/// A recorded design assumption. Machine-level when `assemblyId` is null.
model DesignAssumption {
  id              String   @id @default(cuid())
  configurationId String
  assemblyId      String?
  statement       String
  /// Optional rationale / justification for the assumption.
  rationale       String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  configuration MachineConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  assembly      Assembly?            @relation(fields: [assemblyId], references: [id], onDelete: Cascade)

  @@index([configurationId])
  @@index([assemblyId])
  @@map("design_assumptions")
}

/// A load case (normal, peak, holding, emergency-stop) defined for a
/// configuration. Per-case parameter magnitudes are `ParameterValue`s tagged
/// with the matching `loadCase`.
model LoadCase {
  id              String           @id @default(cuid())
  configurationId String
  category        LoadCaseCategory
  label           String
  description     String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  configuration MachineConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@index([configurationId])
  @@map("load_cases")
}

/// An authored value at a parameter-graph node: a provider value
/// (machine requirement / assembly parameter / workflow-provided) or a value
/// entered on a module input port. `value` is a versioned `EngineeringValue`
/// JSONB payload, validated with the lib/engine/values schemas on write and
/// read (context/code-standards.md "Validation": never trust JSONB). Nothing
/// here is module-specific — the node is identified by canonical `parameterId`.
model ParameterValue {
  id               String               @id @default(cuid())
  configurationId  String
  /// Scope of a provider value (null = machine/configuration root scope).
  assemblyId       String?
  /// Set when this value is entered on a module input port.
  moduleInstanceId String?
  nodeKind         ParameterNodeKind
  /// Canonical parameter ID, e.g. "motion.axis.payload_mass".
  parameterId      String
  loadCase         LoadCaseCategory?
  source           ParameterValueSource
  /// Serialized `EngineeringValue` (Unit 1.1). Validated on write and read.
  value            Json
  createdAt        DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(6)

  configuration  MachineConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  assembly       Assembly?            @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  moduleInstance ModuleInstance?      @relation(fields: [moduleInstanceId], references: [id], onDelete: Cascade)

  @@index([configurationId])
  @@index([assemblyId])
  @@index([moduleInstanceId])
  @@map("parameter_values")
}

/// A confirmed parameter link: a value flows from a provider node (source) to
/// a module input port (target). Links are never created silently (invariant
/// "No silent binding") and can never form a cycle — the application layer
/// rejects cycles with lib/engine/graph before persisting (invariant "Acyclic
/// graph"). A module input takes at most one confirmed source, enforced by the
/// unique constraint on the target port.
model ParameterLink {
  id              String @id @default(cuid())
  configurationId String

  /// Target: always a module input port.
  targetModuleInstanceId String
  targetParameterId      String
  targetLoadCase         LoadCaseCategory?

  /// Source: a provider node. `sourceModuleInstanceId` is set when the source
  /// is another module's output port; `sourceAssemblyId` scopes a
  /// requirement/assembly/workflow provider value (null = machine root).
  sourceKind             ParameterNodeKind
  sourceModuleInstanceId String?
  sourceAssemblyId       String?
  sourceParameterId      String
  sourceLoadCase         LoadCaseCategory?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  configuration        MachineConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  targetModuleInstance ModuleInstance       @relation("ParameterLinkTarget", fields: [targetModuleInstanceId], references: [id], onDelete: Cascade)
  sourceModuleInstance ModuleInstance?      @relation("ParameterLinkSource", fields: [sourceModuleInstanceId], references: [id], onDelete: Cascade)
  sourceAssembly       Assembly?            @relation(fields: [sourceAssemblyId], references: [id], onDelete: Cascade)

  @@unique([targetModuleInstanceId, targetParameterId, targetLoadCase])
  @@index([configurationId])
  @@index([targetModuleInstanceId])
  @@index([sourceModuleInstanceId])
  @@map("parameter_links")
}

// --- Unit 2.3: immutable calculation runs --------------------------------

/// Overall/aggregate check state. Mirrors `CheckStatus` in lib/engine/trace
/// (Unit 1.5): a warning never masks a fail; an empty check set is
/// `not_applicable` (context/ui-context.md "Status Model").
enum CheckStatus {
  pass
  fail
  warning
  not_applicable
  invalid_input
}

/// An immutable calculation-run snapshot (context/architecture.md "Calculation
/// Reproducibility"). The full resolved input, outputs, trace, checks,
/// warnings, assumptions, validity, and version pins live in `snapshot`
/// (versioned JSONB validated on write and read); `status` and `criticalMargin`
/// are search-critical summaries normalized out of it, and the version columns
/// are normalized for filtering. Only `stale`/`staleReason` may ever change —
/// the engineering snapshot is write-once (invariant "Immutable runs";
/// enforced by a DB trigger added in this unit's migration). A correction is a
/// new run, never an edit.
model CalculationRun {
  id               String @id @default(cuid())
  moduleInstanceId String

  /// Version pins, normalized from `snapshot.versions` for reproducibility and
  /// filtering (context/architecture.md: engine/module/registry version fields).
  engineSdkVersion         String
  modulePackageId          String
  moduleVersion            String
  modulePackageHash        String
  parameterRegistryVersion String

  /// Search-critical summaries derived from the snapshot's checks.
  status         CheckStatus
  /// Smallest dimensionless (safety-factor) check margin, or null when none is
  /// dimensionless. Authoritative per-check margins (with units) are in `snapshot`.
  criticalMargin Float?

  /// The only mutable engineering-relevant state: staleness.
  stale       Boolean @default(false)
  staleReason String?

  /// Clerk user ID of who ran it (null when unattributed); the run timestamp.
  createdByUserId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  /// Full immutable computation snapshot (resolved input + computation + version
  /// block). Validated with the lib/engine schemas on write and read.
  snapshot Json

  moduleInstance       ModuleInstance        @relation(fields: [moduleInstanceId], references: [id], onDelete: Cascade)
  componentAssignments ComponentAssignment[]

  @@index([moduleInstanceId])
  @@index([stale])
  @@map("calculation_runs")
}

// --- Unit 2.4: append-only audit events ----------------------------------

/// An append-only engineering audit event (context/architecture.md "Audit":
/// `AuditEvent`), scoped to the owning project so it cascades and lists with
/// it. Minimal shape sufficient for Unit 2.4's "append an audit event" step;
/// the full audit *service* (query surfaces, `ChangeReason`) is Unit 2.9. No
/// update or delete path is exposed at the repository — invariant
/// "append-only" is a service rule here (no engineering field survives to
/// protect with a DB trigger the way `CalculationRun` does).
model AuditEvent {
  id String @id @default(cuid())

  projectId String
  /// Stable dotted event type, e.g. "calculation_run.created".
  eventType String
  /// The kind of record the event concerns, e.g. "CalculationRun".
  entityType String
  entityId   String
  /// Clerk user ID of who performed the action; null when unattributed.
  userId String?
  /// Small descriptive JSONB payload. Never the full engineering snapshot —
  /// that stays on the entity's own immutable record; this is a summary.
  payload Json

  occurredAt DateTime @default(now()) @db.Timestamptz(6)

  project MachineProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([entityType, entityId])
  @@map("audit_events")
}

// --- Unit 2.6: manufacturer catalog schema --------------------------------

/// A manufacturer of catalog parts (context/architecture.md "Catalog and BOM":
/// `Manufacturer`). Shared reference data, not project-owned — every project's
/// component filtering reads from the same imported catalog, unlike the
/// project hierarchy above which is strictly per-owner
/// (context/architecture.md "Auth and Access").
model Manufacturer {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  partRevisions ManufacturerPartRevision[]
  importBatches CatalogImportBatch[]

  @@map("manufacturers")
}

/// A catalog component type (e.g. "ball_screw", "linear_guide"). `id` is a
/// stable slug set by the caller, not a generated cuid — mirroring
/// `ModuleInstance.modulePackageId`'s convention for a code-referenced stable
/// identifier, since a future catalog-matching adapter keys its filtering
/// logic by this string. Adding a new component type never requires a Prisma
/// schema change (Unit 2.6 exit criterion): its attribute shape lives in a
/// `ComponentSchemaVersion` row, not a new column or table.
model ComponentType {
  id          String   @id
  name        String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  schemaVersions ComponentSchemaVersion[]
  partRevisions  ManufacturerPartRevision[]
  importBatches  CatalogImportBatch[]

  @@map("component_types")
}

/// A versioned attribute-field declaration for one `ComponentType`
/// (context/architecture.md "lib/catalog/": "Component-type schemas").
/// `fields` is a versioned JSONB array of `ComponentAttributeFieldDefinition`
/// (lib/catalog), validated on write and read. A `ManufacturerPartRevision`'s
/// generic `attributes` JSONB is validated only as well-formed
/// `EngineeringValue`s at this schema unit; matching it against a specific
/// version's field list is a catalog import/matching concern (Units 2.7/2.8).
model ComponentSchemaVersion {
  id              String   @id @default(cuid())
  componentTypeId String
  version         String
  fields          Json
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  componentType ComponentType              @relation(fields: [componentTypeId], references: [id], onDelete: Cascade)
  partRevisions ManufacturerPartRevision[]

  @@unique([componentTypeId, version])
  @@index([componentTypeId])
  @@map("component_schema_versions")
}

/// A batch of manufacturer part revisions imported together (context/
/// architecture.md "Catalog and BOM": `CatalogImportBatch`). Unit 2.6 recorded
/// only batch identity/provenance; Unit 2.7 part 2 adds the import-mapping
/// identity and row-count summary, computed once (this MVP imports
/// synchronously, not via a job queue) and written together with the batch —
/// nullable because a batch conceptually could exist before its summary is
/// known if that changes later, mirroring `ModuleInstance.lastRunStatus`'s
/// "null until computed" convention. The full per-row error report is
/// intentionally NOT persisted here (no UI reads historical import errors
/// yet) — `lib/application/catalogs/import-catalog.ts` returns it directly to
/// its caller instead.
model CatalogImportBatch {
  id               String   @id @default(cuid())
  componentTypeId  String
  manufacturerId   String
  sourceLabel      String
  importedByUserId String?
  /// Identity of the `lib/catalog` `ImportMapping` used, for the
  /// "idempotent by manufacturer, part number, source revision, and import
  /// mapping" traceability requirement (context/code-standards.md "Catalog").
  importMappingId      String?
  importMappingVersion String?
  totalRowCount        Int?
  validRowCount        Int?
  invalidRowCount      Int?
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  componentType ComponentType              @relation(fields: [componentTypeId], references: [id], onDelete: Restrict)
  manufacturer  Manufacturer               @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  partRevisions ManufacturerPartRevision[]

  @@index([componentTypeId])
  @@index([manufacturerId])
  @@map("catalog_import_batches")
}

/// Lifecycle of a manufacturer part, when known (context/code-standards.md
/// "Catalog"). Null on `ManufacturerPartRevision.lifecycleStatus` means unknown
/// ("Lifecycle status when known" — project-overview.md "Manufacturer Part Data").
enum PartLifecycleStatus {
  active
  not_recommended_for_new_design
  obsolete
  discontinued
}

/// Data-quality state of an imported/entered manufacturer part revision
/// (project-overview.md "Manufacturer Part Data": "Data quality status and
/// validation errors").
enum DataQualityStatus {
  valid
  warning
  error
}

/// A single manufacturer part specification, versioned and source-backed
/// (context/code-standards.md "Catalog": "Manufacturer part specifications are
/// versioned and source-backed"). Identity/revision/lifecycle fields are
/// relational; `attributes` is a versioned JSONB payload of attribute key to
/// `EngineeringValue` (lib/catalog), validated on write and read (never trust
/// JSONB) — component-specific attributes for every component type coexist in
/// this one generic column (Unit 2.6 exit criterion). No company-approval,
/// supplier, pricing, or inventory fields exist here (context/roadmap.md
/// "Explicitly Deferred").
model ManufacturerPartRevision {
  id                       String  @id @default(cuid())
  manufacturerId           String
  componentTypeId          String
  componentSchemaVersionId String
  partNumber               String
  /// Catalog edition/date or cited document revision identity. A plain string,
  /// not a `lib/standards` `SourceRevision` id — a manufacturer catalog entry
  /// is not necessarily a formally registered source document.
  sourceRevision    String
  sourceLink        String?
  lifecycleStatus   PartLifecycleStatus?
  dataQualityStatus DataQualityStatus    @default(valid)
  validationErrors  String[]             @default([])
  /// Versioned `ComponentAttributes` JSONB (lib/catalog): attribute key to
  /// `EngineeringValue`, validated on write and read.
  attributes    Json
  importBatchId String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  manufacturer           Manufacturer           @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  componentType          ComponentType          @relation(fields: [componentTypeId], references: [id], onDelete: Restrict)
  componentSchemaVersion ComponentSchemaVersion @relation(fields: [componentSchemaVersionId], references: [id], onDelete: Restrict)
  /// `Restrict`, not `SetNull` (ADR-0006): a part revision is immutable, so its
  /// recorded provenance cannot be detached — deleting the batch that produced
  /// a revision would silently rewrite where that revision came from. The
  /// `manufacturer_part_revisions_immutable_guard` trigger would reject the
  /// resulting UPDATE anyway; `Restrict` fails the delete with a clear FK error
  /// instead.
  importBatch            CatalogImportBatch?    @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  datasheetAttachments   DatasheetAttachment[]
  componentAssignments   ComponentAssignment[]

  @@unique([manufacturerId, partNumber, sourceRevision])
  @@index([componentTypeId])
  @@index([componentSchemaVersionId])
  @@index([importBatchId])
  @@map("manufacturer_part_revisions")
}

/// Datasheet/catalog-source attachment metadata for a manufacturer part
/// revision (context/architecture.md "Blob storage": "checksum, MIME type,
/// size, upload source, and access control metadata"). This unit records the
/// metadata row only; the blob storage integration itself (upload endpoint,
/// storage backend, signed URLs) is a later concern — `storageKey` is a
/// placeholder locator until that exists.
model DatasheetAttachment {
  id                         String   @id @default(cuid())
  manufacturerPartRevisionId String
  fileName                   String
  mimeType                   String
  sizeBytes                  Int
  checksum                   String
  storageKey                 String
  uploadSource               String
  uploadedByUserId           String?
  createdAt                  DateTime @default(now()) @db.Timestamptz(6)

  manufacturerPartRevision ManufacturerPartRevision @relation(fields: [manufacturerPartRevisionId], references: [id], onDelete: Cascade)

  @@index([manufacturerPartRevisionId])
  @@map("datasheet_attachments")
}

// --- Unit 2.8: component assignment ---------------------------------------

/// What a `ComponentAssignment` is attached to. Mirrors `ParameterLink.sourceKind`'s
/// discriminator-plus-nullable-columns pattern: exactly one of
/// `moduleInstanceId`/`assemblyId` is meaningful per kind, enforced at the
/// repository boundary (Zod `.refine`), not a DB CHECK constraint.
enum ComponentAssignmentTargetKind {
  /// The assignment fulfills a specific module instance's calculated
  /// requirement (a "calculated component"). `moduleInstanceId` is set;
  /// `assemblyId` is not (the module instance's own assembly already scopes it).
  module_instance
  /// The assignment has no supporting calculation (e.g. a manual bracket).
  /// `assemblyId` may be set (assembly-scoped) or omitted (machine/configuration
  /// root), the same nullable-`assemblyId` convention `Requirement`/
  /// `DesignAssumption` already use — together these three states cover the
  /// implementation map's "target project/assembly/module."
  assembly
}

/// How a `ComponentAssignment`'s part is identified. Mirrors
/// `ComponentReference.source` (lib/engine/values, Unit 1.1), which was
/// defined specifically to mirror this model.
enum ComponentAssignmentPartSource {
  catalog
  manual
}

/// A lightweight link from a target to an assigned part
/// (context/architecture.md "Catalog and BOM": `ComponentAssignment`;
/// "intentionally lightweight... not an approval workflow";
/// project-overview.md "Manufacturer Part Data": "required for BOM generation
/// and stale detection"). Unlike the catalog reference tables (Unit 2.6),
/// this model IS project-scoped — see the Unit 2.6 architecture decision in
/// context/progress-tracker.md ("ComponentAssignment is where a specific
/// project links to a specific catalog part revision").
///
/// `partSource` discriminates the part reference: `catalog` sets
/// `manufacturerPartRevisionId` (an exact revision, never a bare part
/// number — "Exact part revision retained"); `manual` sets
/// `manualPartDetails` (lib/catalog, validated JSONB). This is independent of
/// `targetKind`: a manual part can still be assigned to a `module_instance`
/// target (an engineer's own hand-picked substitute for a calculated
/// requirement).
///
/// `calculationRunId` is the justifying run for a calculated component
/// (implementation map: "Supporting run required for calculated components")
/// — required when `targetKind` is `module_instance`, optional otherwise (a
/// manual/assembly-level part has no calculation to justify it).
///
/// `stale` mirrors `CalculationRun.stale`: propagated in the same transaction
/// as its justifying run going stale (context/architecture.md invariant
/// "Transactional stale propagation": "downstream runs and component
/// assignments become stale in the same transaction"). This does NOT
/// implement Unit 2.5's fourth deferred stale-propagation trigger ("change an
/// assigned-component feedback input" — an assignment acting as a *source*
/// of a value other calculations consume, which would need a new
/// parameter-graph node kind and is a materially larger, still-deferred
/// feature); it only implements the simpler, explicitly-named direction: an
/// assignment goes stale when the run that justifies it does.
model ComponentAssignment {
  id              String @id @default(cuid())
  configurationId String

  targetKind       ComponentAssignmentTargetKind
  moduleInstanceId String?
  assemblyId       String?

  partSource                 ComponentAssignmentPartSource
  manufacturerPartRevisionId String?
  /// A `ManualPartDetails` (lib/catalog) JSONB payload, validated on write and
  /// read. Set only when `partSource` is `manual`.
  manualPartDetails Json?

  quantity         Int     @default(1)
  calculationRunId String?

  stale       Boolean @default(false)
  staleReason String?

  assignedByUserId String?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  configuration            MachineConfiguration      @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  moduleInstance           ModuleInstance?           @relation(fields: [moduleInstanceId], references: [id], onDelete: Cascade)
  assembly                 Assembly?                 @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  manufacturerPartRevision ManufacturerPartRevision? @relation(fields: [manufacturerPartRevisionId], references: [id], onDelete: Restrict)
  calculationRun           CalculationRun?           @relation(fields: [calculationRunId], references: [id], onDelete: Restrict)

  @@index([configurationId])
  @@index([moduleInstanceId])
  @@index([assemblyId])
  @@index([manufacturerPartRevisionId])
  @@index([calculationRunId])
  @@map("component_assignments")
}

// --- Unit 2.9: machine baselines ------------------------------------------

/// An immutable machine baseline (context/architecture.md "Core Domain
/// Model": `MachineBaseline`; ADR-0002 "Immutable calculation runs and
/// baselines"; invariant 11 "Baseline immutability"). Freezes the
/// requirements/assumptions, assembly/module tree, parameter values and
/// links, calculation-run IDs and package hashes, and component assignments
/// in effect at creation, as a versioned JSONB `MachineBaselineSnapshot`
/// (lib/configuration, Unit 2.9 part 1), validated on write and read like
/// every other stored snapshot in this schema. Unlike `CalculationRun`,
/// nothing on a baseline is ever mutable — not even a stale flag — so there
/// is no legitimate UPDATE path at all; the migration's immutability-guard
/// trigger rejects every UPDATE unconditionally, one step stricter than
/// `calculation_runs_immutable_guard`, which still allows the stale-state
/// columns to change.
model MachineBaseline {
  id              String @id @default(cuid())
  configurationId String
  /// Human-readable label shown in the baseline list (Unit 3.8 UI), e.g.
  /// "Design review 1" or "v1.0 release".
  label           String
  /// Full immutable snapshot (lib/configuration `MachineBaselineSnapshot`),
  /// validated with lib/configuration's schema on write and read.
  snapshot        Json
  createdByUserId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  configuration MachineConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@index([configurationId])
  @@map("machine_baselines")
}
